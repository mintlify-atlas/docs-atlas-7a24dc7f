  "keyFeatures": [
    "Interactive coding agent CLI with read, write, edit, and bash tools",
    "Unified multi-provider LLM API supporting 15+ providers",
    "Extensible agent framework with TypeScript hooks and plugins",
    "Terminal UI library with differential rendering",
    "Web components for AI chat interfaces",
    "Slack bot integration for team collaboration",
    "vLLM deployment management for GPU pods"
  ],
  "publicApiSurface": [
    "pi (CLI command)",
    "stream() / complete() - LLM API functions",
    "AgentSession - Core agent runtime",
    "createAgentSession() - SDK factory",
    "Extension system - Hooks, tools, commands",
    "Terminal - TUI rendering engine",
    "ChatPanel - Web UI component",
    "mom (Slack bot CLI)",
    "pi-pods (vLLM deployment CLI)"
  ]
